{"version":1,"title":"标签：蘭月 - SamuFlore","html":"<div class=\"l_main\" data-ui-surface=\"content\">\n\n\n\n\n \n\n\n\n\n\n<div class=\"navbar top\"><div class=\"navbar-blur\"><div class=\"navbar-container\"><nav class=\"post\"><a href=\"/\">近期发布</a><a href=\"/categories/\">分类</a><a class=\"active\" href=\"/tags/\">标签：蘭月</a><a href=\"/topic/\">专栏</a><a href=\"/archives/\">归档</a><a href=\"/recent/\">BAKER</a></nav></div></div></div>\n\n<div class=\"post-list post\"><div class=\"post-card-wrap\"><a class=\"post-card post card-hover card-hover--spotlight card-hover--tilt\" href=\"/posts/8db1062d/\">\n<article class=\"md-text\"><h2 class=\"post-title\">[BUAA ML]Post-Training</h2><div class=\"excerpt\"><p>LoRA, RLHF, etc.</p></div><div class=\"meta cap\"><span class=\"cap preview-post-meta\" id=\"post-meta\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" data-icon=\"default:calendar\" aria-hidden=\"true\"></svg><time datetime=\"2026-07-12T08:55:33.000Z\">2026-07-12</time></span><span class=\"cap breadcrumb\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" data-icon=\"default:category\" aria-hidden=\"true\"></svg><span>2025 - 2026 學年 / Machine Learning</span></span></div></article>\n</a></div><div class=\"post-card-wrap\"><a class=\"post-card post card-hover card-hover--spotlight card-hover--tilt\" href=\"/posts/8b370a4c/\">\n<article class=\"md-text\"><h2 class=\"post-title\">[BUAA ML]Transformer</h2><div class=\"excerpt\"><p>Attention is ALL U need!</p></div><div class=\"meta cap\"><span class=\"cap preview-post-meta\" id=\"post-meta\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" data-icon=\"default:calendar\" aria-hidden=\"true\"></svg><time datetime=\"2026-07-11T08:50:14.000Z\">2026-07-11</time></span><span class=\"cap breadcrumb\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" data-icon=\"defau